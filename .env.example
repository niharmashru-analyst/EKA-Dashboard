# Required
SECRET_KEY=change-me-to-a-long-random-string
# Recommended
ADMIN_EMAIL=admin@cormate.com
ADMIN_PASSWORD=
# Data sources (optional; bundled files are used when blank)
EXCEL_URL=
VARIANCE_EXCEL_URL=
SUBMISSION_API_URL=
SUBMISSION_API_SECRET=
GEMINI_API_KEY=
# Behaviour
INWARD_ENABLED=0
SESSION_HOURS=12
LOGIN_MAX_FAILS=5
TRUST_PROXY=1
SESSION_COOKIE_SECURE=1   # set 0 only for local http development
# Admin Control Center
SHOPS_JSON_PATH=
ADMIN_UPLOAD_MAX_MB=15
UPLOAD_LINK_HOURS=48
# Optional: persist admin user/shop changes to GitHub so they survive Render redeploys
GITHUB_CONFIG_TOKEN=
GITHUB_CONFIG_REPO=
GITHUB_CONFIG_BRANCH=main
GITHUB_USERS_PATH=data/users.json
GITHUB_MAPPING_PATH=data/mapping.json
GITHUB_SHOPS_PATH=data/shops.json

# Public URL used when generating shareable manual upload links
PUBLIC_BASE_URL=https://your-app.onrender.com

# Email address authorised to approve/reject stock variance cases
HOD_EMAIL=hod@company.com
# Field-entry session timer (server-enforced) + drafts
ENTRY_SESSION_SECONDS=900
ENTRY_SESSION_GRACE_SECONDS=60
ENTRY_SESSION_ENFORCE=1
# Drafts are stored in the same SQLite file as local submissions. On hosts with an ephemeral disk
# (e.g. Render free tier) point DATABASE_PATH at a persistent disk, otherwise server drafts reset on redeploy
# (the browser keeps its own copy as a fallback).

# --- Sales dashboard / reports / master JSON ---
# SALES_EXCEL_URL=            # optional: link to the sales Excel (else admin uploads it in Admin > Upload)
# SALES_FILE=/var/data/sales.xlsx   # where an uploaded sales workbook is kept - put it on a persistent disk
# SALES_CACHE_SECONDS=300
# MASTER_JSON_TOKEN=          # optional: lets another system read /api/master-skus.json with ?token= or Bearer
# REPORT_TZ=Asia/Kolkata
