# Required
SECRET_KEY=change-me-to-a-long-random-string
# Recommended
ADMIN_EMAIL=admin@cormate.com
ADMIN_PASSWORD=
# Data sources (optional; bundled files are used when blank)
EXCEL_URL=
VARIANCE_EXCEL_URL=
SUBMISSION_API_URL=
SUBMISSION_API_SECRET=
GEMINI_API_KEY=
# Behaviour
INWARD_ENABLED=0
SESSION_HOURS=12
LOGIN_MAX_FAILS=5
TRUST_PROXY=1
SESSION_COOKIE_SECURE=1   # set 0 only for local http development
# Admin Control Center
SHOPS_JSON_PATH=
ADMIN_UPLOAD_MAX_MB=15
UPLOAD_LINK_HOURS=48
# Optional: persist admin user/shop changes to GitHub so they survive Render redeploys
GITHUB_CONFIG_TOKEN=
GITHUB_CONFIG_REPO=
GITHUB_CONFIG_BRANCH=main
GITHUB_USERS_PATH=data/users.json
GITHUB_MAPPING_PATH=data/mapping.json
GITHUB_SHOPS_PATH=data/shops.json

# Public URL used when generating shareable manual upload links
PUBLIC_BASE_URL=https://your-app.onrender.com

# Email address authorised to approve/reject stock variance cases
HOD_EMAIL=hod@company.com
